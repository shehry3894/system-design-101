# PostgreSQL Database
POSTGRES_SERVER=identity-db
POSTGRES_USER=adminuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=identity_db
DATABASE_URL=postgresql://adminuser:change-me@identity-db:5432/identity_db

# JWT Settings
SECRET_KEY=change-me
# HMAC-SHA256, symmetric. using as only this service will be issuing + validating
# Why not RS256? Will use RS256 is other services need validation as well, in a distributed system environment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

